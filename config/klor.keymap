//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/behaviors.h>


// Definitions //

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NAV 3

#define ___ &trans
#define slashP &th LS(SLASH) P
#define HYPEReturn &tb LS(LC(LA(LGUI))) RETURN
#define MehSpace &tb LS(LC(LALT)) SPACE


// Combos//
/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            timeout-ms = <40>;
            bindings = <&kp RETURN>;
            key-positions = <12 13 14>;
        };

        ctrl-backspace {
            timeout-ms = <40>;
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <24 25 26>;
        };

        left-parenthesis {
            timeout-ms = <40>;
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
        };

        right-parenthesis {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <1 2>;
        };

        left-bracket {
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <13 14>;
        };

        right-bracket {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <12 13>;
        };

        left-brace {
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACE>;
            key-positions = <25 26>;
        };

        right-brace {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <24 25>;
        };

        combo_colon {
            timeout-ms = <40>;
            bindings = <&kp SEMI>;
            key-positions = <11 12>;
        };

        combo_angle {
            timeout-ms = <40>;
            bindings = <&angle_morph>;
            key-positions = <12 14>;
        };

    };

    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 28 29 30 31 32 33 39 40 41>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36>;
        };

        th: th {
            compatible = "zmk,behavior-hold-tap";
            label = "Taphold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tb: tb {
            compatible = "zmk,behavior-hold-tap";
            label = "Thumb hold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tc: tc {
          compatible = "zmk,behavior-hold-tap";
          label = "Thumb hold for layer";
          bindings = <&mo>, <&kp>;

          #binding-cells = <2>;
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "tap-preferred";
      };
        
        tb_B: tb_B {
            compatible = "zmk,behavior-tap-dance";
            label = "TB_B";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp LC(B)>;
            tapping-term-ms = <200>;
        };

        angle_morph: angle_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "angle_morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamRT: GamRT {
            compatible = "zmk,behavior-mod-morph";
            label = "GamRT";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp T>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamFG: GamFG {
            compatible = "zmk,behavior-mod-morph";
            label = "GamFG";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp G>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamVB: GamVB {
            compatible = "zmk,behavior-mod-morph";
            label = "GamVB";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp B>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamEI: GamEI {
            compatible = "zmk,behavior-mod-morph";
            label = "GamEI";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp I>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        vim_left: vim_left {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_left";
          #binding-cells = <0>;
          bindings = <&kp LEFT>, <&kp N0>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
        
        vim_right: vim_right {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_right";
          #binding-cells = <0>;
          bindings = <&kp RIGHT>, <&kp DLLR>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
        
        comma_morph: comma_morph {
          compatible = "zmk,behavior-mod-morph";
          label = "comma_morph";
          #binding-cells = <0>;
          bindings = <&kp COMMA>, <&kp DOT>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };

    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "BASE";

            // └───────────────────────────────────────────────────────────┘
        /*   ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │    B    │    L    │    D    │    W    │    Z    │                    │    "    │    F    │    O    │    U    │    J    │   
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │   TAB   │    N    │    R    │    T    │    S    │    G    │                    │    Y    │    H    │    A    │    E    │    I    │    ,    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │   4     │    Q    │    X    │    M    │    C    │    V    ││  MUTE  ││PLY/PSE ││    K    │    P    │    .    │    -    │    /    │   ESC   │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │    1    │  BACK   │  SHIFT  │ CMD/WIN ││ CMD/WIN │  ENTER  │  SPACE  │    2    │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
                &kp J      &kp U         &kp O           &HML LGUI F    &kp SQT                          &kp Z    &HMR LGUI W   &kp D           &kp L          &kp B
    &kp COMMA   &lt 2 I    &HML LCTRL E  &HML LALT A     &lt 3 H        &kp Y                            &kp G    &lt 3 S       &HMR LALT T     &HMR LCTRL R   &lt 2 N    &kp TAB  
    &kp ESCAPE  &kp SLASH  &kp MINUS     &comma_morph    slashP         &kp K     &kp C_MUTE  &kp C_PP   &kp V    &kp C         &kp M           &kp X          &kp Q      &tog 1    
                           &mo 2         MehSpace        HYPEReturn     &none                            &none    &kp LSHIFT    &kp BACKSPACE   &mo 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        lower_layer {
            label = "Lower";
        
            bindings = <
                 &kp N0  &kp N9  &kp N8  &kp N7  ___                       ___    ___         &kp STAR     &kp AMPS    ___
            ___  ___     &kp N6  &kp N5  &kp N4  ___                       ___    &kp CARET   &kp PRCNT    &kp DLLR    &kp ESCAPE    ___
            ___  ___     &kp N3  &kp N2  &kp N1  ___        ___ ___        ___    &kp HASH    &kp AT       &kp EXCL    ___           ___
                         ___     ___     ___     ___                       ___    ___         ___        ___
            >;
        
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        
        raise_layer {
            label = "Raise";
        
            bindings = <
                         ___         &kp F9    &kp F8    &kp F7    &kp F12                        ___    ___          ___          ___    ___
            &kp TILDE    &kp BSLH    &kp F6    &kp F5    &kp F4    &kp F11                        ___    &kp EQUAL    &kp MINUS    &kp TILDE    &kp ESCAPE    ___
            &kp GRAVE    &kp PIPE    &kp F3    &kp F2    &kp F1    &kp F10        ___  ___        ___    &kp PLUS     &kp UNDER    &kp GRAVE    ___           ___
                                          ___       ___       ___       ___                       ___    ___          ___          ___
            >;
        
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        
        nav_layer {
            label = "Nav";
        
            bindings = <
                   ___              &kp LC(V)    ___             &kp LC(C)    &kp PG_DN                       &kp PG_UP    &kp C_MUTE      &kp DELETE    &kp LC(TAB)    ___
            ___    &kp LC(EQUAL)    &kp RIGHT    &kp UP          &kp DOWN     &kp LEFT                        ___          &kp C_VOL_UP    ___           &kp TAB        &kp ESCAPE    ___
            ___    &kp LC(MINUS)    &kp PG_DN    &kp CAPSLOCK    &kp PG_UP    ___             ___  ___        ___          &kp C_VOL_DN    ___           ___            ___           ___
                                    ___          ___             ___          ___                             ___          ___             ___           ___
            >;
        
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
