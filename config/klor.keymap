//                               █         █    █            ▄▄▄▀▀▀▀▀▀▄▄▄        █▀▀▀▀▀▀▀▀▀▀█
//                               █        █     █          ▄▀            ▀▄      █          █
//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/behaviors.h>


// Definitions //

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NAV 3

#define ___ &trans
#define slashP &th LS(SLASH) P
#define HYPEReturn &tb LS(LC(LA(LGUI))) RETURN
#define MehSpace &tb LS(LC(LALT)) SPACE


// Combos//
/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            timeout-ms = <40>;
            bindings = <&kp RETURN>;
            key-positions = <17 18 19>;
        };

        ctrl-backspace {
            timeout-ms = <40>;
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <31 32 33>;
        };

        left-parenthesis {
            timeout-ms = <40>;
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        right-parenthesis {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        left-bracket {
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
        };

        right-bracket {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        left-brace {
            timeout-ms = <40>;
            bindings = <&kp LEFT_BRACE>;
            key-positions = <31 32>;
        };

        right-brace {
            timeout-ms = <40>;
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 33>;
        };

        combo_colon {
            timeout-ms = <40>;
            bindings = <&kp SEMI>;
            key-positions = <19 20>;
        };

        combo_angle {
            timeout-ms = <40>;
            bindings = <&angle_morph>;
            key-positions = <17 19>;
        };

    };

    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 28 29 30 31 32 33 39 40 41>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36>;
        };

        th: th {
            compatible = "zmk,behavior-hold-tap";
            label = "Taphold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tb: tb {
            compatible = "zmk,behavior-hold-tap";
            label = "Thumb hold";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            // require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        tc: tc {
          compatible = "zmk,behavior-hold-tap";
          label = "Thumb hold for layer";
          bindings = <&mo>, <&kp>;

          #binding-cells = <2>;
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          flavor = "tap-preferred";
      };
        
        tb_B: tb_B {
            compatible = "zmk,behavior-tap-dance";
            label = "TB_B";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp LC(B)>;
            tapping-term-ms = <200>;
        };

        angle_morph: angle_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "angle_morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamRT: GamRT {
            compatible = "zmk,behavior-mod-morph";
            label = "GamRT";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp T>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamFG: GamFG {
            compatible = "zmk,behavior-mod-morph";
            label = "GamFG";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp G>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamVB: GamVB {
            compatible = "zmk,behavior-mod-morph";
            label = "GamVB";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp B>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        GamEI: GamEI {
            compatible = "zmk,behavior-mod-morph";
            label = "GamEI";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp I>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        vim_left: vim_left {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_left";
          #binding-cells = <0>;
          bindings = <&kp LEFT>, <&kp N0>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
        
        vim_right: vim_right {
          compatible = "zmk,behavior-mod-morph";
          label = "vim_right";
          #binding-cells = <0>;
          bindings = <&kp RIGHT>, <&kp DLLR>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };


    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "BASE";

            // └───────────────────────────────────────────────────────────┘
        /*   ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │    B    │    L    │    D    │    W    │    Z    │                    │    "    │    F    │    O    │    U    │    J    │   
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │   TAB   │    N    │    R    │    T    │    S    │    G    │                    │    Y    │    H    │    A    │    E    │    I    │    ,    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │   4     │    Q    │    X    │    M    │    C    │    V    ││  MUTE  ││PLY/PSE ││    K    │    P    │    .    │    -    │    /    │   ESC   │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │    1    │  BACK   │  SHIFT  │ CMD/WIN ││ CMD/WIN │  ENTER  │  SPACE  │    2    │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
             &kp B    &kp L         &kp D         &HML LGUI W    &kp Z                           &kp SQT    &HMR LGUI F  &kp O          &kp U          &kp J
    &kp TAB  &lt 2 N  &HML LCTRL R  &HML LALT T   &lt 3 S        &kp G                           &kp Y      &lt 3 H      &HMR LALT A    &HMR LCTRL E   &lt 2 I    &kp COMMA
    &tog 1   &kp Q    &kp X         &kp M         &kp C          &kp V   &kp C_MUTE  &kp C_PP    &kp K      slashP       &kp PERIOD     &kp MINUS      &kp SLASH  &kp ESCAPE
                      &mo 1         &kp BACKSPACE &kp LSHIFT     &trans                          &trans     HYPEReturn   MehSpace       &mo 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        lower_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "Lower";

            // └───────────────────────────────────────────────────────────┘
            /*         ┌─────────┬─────────┬─────────┬─────────┬                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │         │    &    │    *    │         │         │                    │         │    7    │    8    │    9    │    0    │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │   ESC   │    $    │    %    │    ^    │         │                    │         │    4    │    5    │    6    │         │         │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │    !    │    @    │    #    │         ││        ││        ││         │    1    │    2    │    3    │         │         │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │         │         │         │         ││         │         │         │         │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
            ___         &kp AMPS   &kp STAR    ___         ___                         ___      &kp N7  &kp N8  &kp N9  &kp N0
    ___     &kp ESCAPE  &kp DLLR   &kp PRCNT   &kp CARET   ___                         ___      &kp N4  &kp N5  &kp N6  ___     ___
    ___     ___         &kp EXCL   &kp AT      &kp HASH    ___         ___  ___        ___      &kp N1  &kp N2  &kp N3  ___     ___
                        ___       ___          ___         ___                         ___      ___     ___     ___
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        raise_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "Raise";

            // └───────────────────────────────────────────────────────────┘
          /* ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
             │         │         │         │         │         │                    │   F12   │   F7    │   F8    │   F9    │         │
   ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
   │         │   ESC   │         │   -     │    =    │         │                    │   F11   │   F4    │    F5   │   F6    │    \    │    ~    │
   ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
   │         │         │         │   _     │    +    │         ││        ││        ││   F10   │   F1    │    F2   │   F3    │    |    │    `    │
   └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                 │ ADJUST  │         │         │         ││         │         │         │         │  
                                 └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */

            bindings = <
                ___       ___        ___      ___        ___                          &kp F12   &kp F7    &kp F8    &kp F9   ___
        ___  &kp ESCAPE   ___     &kp MINUS &kp EQUAL    ___                          &kp F11   &kp F4    &kp F5    &kp F6   &kp BSLH  &kp TILDE
        ___     ___       ___     &kp UNDER &kp PLUS     ___           ___  ___       &kp F10   &kp F1    &kp F2    &kp F3   &kp PIPE  &kp GRAVE
                          ___        ___      ___        ___                          ___       ___       ___       ___
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┌───────────────────────────────────────────────────────────┐

            label = "Nav";
            bindings = <
                    &trans       &kp LC(TAB)  &kp DELETE   &kp C_MUTE    &kp PG_UP                   &kp PG_DN       &kp LC(C)       &kp UP        &kp LC(V)     &trans
        &trans      &kp ESCAPE   &kp TAB      &trans       &kp C_VOL_UP  &trans                      &kp LEFT        &kp DOWN        &kp UP        &kp RIGHT    &kp LC(EQUAL)  &trans
        &trans      &trans       &trans       &trans       &kp C_VOL_DN  &trans      &trans  &trans  &trans          &trans          &kp CAPSLOCK  &trans        &kp LC(MINUS)  &trans
                                 &trans       &trans       &trans        &trans                      &trans          &trans          &trans        &trans
            >;
                    sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
